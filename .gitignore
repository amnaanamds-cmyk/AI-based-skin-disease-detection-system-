# Datasets and caches stay local (large; often licensed). Keep the folder structure and docs.
data/*
!data/README.md
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# In-progress training state is temporary; trained versions in models/trained/ are kept.
models/checkpoints/
models/*.pt
models/*.json
*.pt
!models/trained/**/model.pt
